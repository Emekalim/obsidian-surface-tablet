{
  "name": "obsidian-surface-tablet",
  "version": "1.0.1",
  "description": "Surface Pen friendly mouse emulation and panning for Obsidian Canvas on Windows.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version.mjs",
    "verify": "npm run lint && npm run format:check && npm run test && npm run check:version && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "surface-pen",
    "stylus",
    "canvas",
    "windows"
  ],
  "author": "Emekalim",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "obsidian": "1.14.4",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
